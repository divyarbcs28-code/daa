#include <stdio.h>

int main()
{
    int n;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    int a[n],i,k;

    printf("Enter elements:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    for(i = 1; i < n; i++)
    {
        int v = a[i];
        int j = i - 1;

        while(j >= 0 && a[j] > v)
        {
            a[j + 1] = a[j];
            j = j - 1;
        }

        a[j + 1] = v;

        printf("Pass %d: ", i);
        for(k = 0; k < n; k++)
            printf("%d ", a[k]);

        printf("\n");
    }

    printf("Sorted array:\n");
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}

